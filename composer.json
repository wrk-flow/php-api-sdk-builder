{
    "name": "wrkflow/php-api-sdk-builder",
    "description": "This package helps you build PHP clients for external APIs with dependency injection and type strict code in mind.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/wrk-flow/php-api-sdk-builder",
    "authors": [
        {
            "name": "Martin Kluska",
            "email": "martin@kluska.cz"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/psr7": "^2.5",
        "php-http/discovery": "^1.14",
        "psr/http-client": "^1.0.1",
        "psr/http-message": "^1.0.1 || ^2.0",
        "wrkflow/php-get-typed-value": "^0.8.2 || ^0.9.0"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^7.4",
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/framework": "^10.0",
        "laravel/telescope": "^4.14.2",
        "league/flysystem": "^3.14",
        "mockery/mockery": "^1.5.1",
        "nyholm/psr7": "^1.8.0",
        "orchestra/testbench": "^8.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^10.5",
        "strictphp/conventions": "^2.1"
    },
    "suggest": {
        "laravel/framework": "SDKs work great with Laravel - solid container.",
        "wrkflow/larastrict": "Improve your Laravel code base with strict conventions."
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "check": "@qa",
        "lint:check": "./vendor/bin/ecs",
        "lint:fix": "./vendor/bin/ecs --fix",
        "lint:stan": "@analyse",
        "lint:stan:baseline": "./vendor/bin/phpstan -b",
        "lint:upgrade:check": "vendor/bin/rector process --dry-run",
        "lint:upgrade": "vendor/bin/rector process",
        "lint": [
            "@lint:upgrade",
            "@lint:fix"
        ],
        "test": "./vendor/bin/phpunit",
        "test:larastrict": "./vendor/bin/phpunit phpstan/tests",
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "analyse": "vendor/bin/phpstan"
    },
    "autoload": {
        "psr-4": {
            "WrkFlow\\ApiSdkBuilder\\": "src/",
            "WrkFlow\\PHPstan\\ApiSdkBuilder\\": "phpstan/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WrkFlow\\ApiSdkBuilderTests\\": "tests/",
            "WrkFlow\\ApiSdkBuilderTests\\PHPStan\\": "phpstan/tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "phpstan/extension.php"
            ]
        },
        "laravel": {
            "providers": [
                "WrkFlow\\ApiSdkBuilder\\Laravel\\LaravelServiceProvider"
            ]
        },
        "strictphp/conventions": {
            "skills": {
                "api-sdk-builder": "resources/ai/api-sdk-builder"
            },
            "instructions": [
                "resources/ai/AGENTS.md"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "symfony/thanks": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        }
    },
    "archive": {
        "exclude": [
            "/docs"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/pionl"
        }
    ]
}
